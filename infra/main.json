{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "18301182209657347782"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for every resource"
      }
    },
    "prefix": {
      "type": "string",
      "metadata": {
        "description": "Short lowercase prefix, 3-12 characters"
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "labadmin",
      "metadata": {
        "description": "Ubuntu administrative username"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Ubuntu password. Supply it at deployment time; never commit it."
      }
    }
  },
  "variables": {
    "$fxv#0": "#cloud-config\npackage_update: true\npackages:\n  - xfce4\n  - xfce4-goodies\n  - xrdp\n  - git\n  - curl\n  - ca-certificates\n  - jq\nruncmd:\n  - sed -i 's/^test -x \\/etc\\/X11\\/Xsession.*/startxfce4/' /etc/xrdp/startwm.sh\n  - systemctl enable xrdp\n  - systemctl restart xrdp\n  - curl -fsSL https://deb.nodesource.com/setup_22.x | bash -\n  - apt-get install -y nodejs\n  - curl -sL https://aka.ms/InstallAzureCLIDeb | bash\n  - mkdir -p /opt/lakera-red-lab\n  - chmod 755 /opt/lakera-red-lab\nfinal_message: \"Lakera Red lab VM bootstrap completed\"\n",
    "suffix": "[toLower(uniqueString(resourceGroup().id, parameters('prefix')))]",
    "acrName": "[take(replace(format('{0}{1}acr', parameters('prefix'), variables('suffix')), '-', ''), 50)]",
    "lawName": "[format('{0}-{1}-law', parameters('prefix'), variables('suffix'))]",
    "environmentName": "[format('{0}-{1}-aca-env', parameters('prefix'), variables('suffix'))]",
    "keyVaultName": "[take(format('{0}-{1}-kv', parameters('prefix'), variables('suffix')), 24)]",
    "vnetName": "[format('{0}-{1}-vnet', parameters('prefix'), variables('suffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-{1}-nat-pip', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/natGateways",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-{1}-nat', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIpAddresses": [
          {
            "id": "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-{1}-nat-pip', parameters('prefix'), variables('suffix')))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-{1}-nat-pip', parameters('prefix'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.40.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "AzureBastionSubnet",
            "properties": {
              "addressPrefix": "10.40.0.0/26"
            }
          },
          {
            "name": "aca-infrastructure",
            "properties": {
              "addressPrefix": "10.40.2.0/23",
              "delegations": [
                {
                  "name": "aca-delegation",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          },
          {
            "name": "lab-vm",
            "properties": {
              "addressPrefix": "10.40.10.0/24",
              "natGateway": {
                "id": "[resourceId('Microsoft.Network/natGateways', format('{0}-{1}-nat', parameters('prefix'), variables('suffix')))]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/natGateways', format('{0}-{1}-nat', parameters('prefix'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-{1}-bastion-pip', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-{1}-bastion', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "bastion-ipconfig",
            "properties": {
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'AzureBastionSubnet')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-{1}-bastion-pip', parameters('prefix'), variables('suffix')))]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-{1}-bastion-pip', parameters('prefix'), variables('suffix')))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-{1}-sdk-vm-nic', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'lab-vm')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "name": "[format('{0}-{1}-sdk-vm', parameters('prefix'), variables('suffix'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2s"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          }
        },
        "osProfile": {
          "computerName": "lakera-sdk-vm",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "customData": "[base64(variables('$fxv#0'))]"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-{1}-sdk-vm-nic', parameters('prefix'), variables('suffix')))]",
              "properties": {
                "primary": true
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-{1}-sdk-vm-nic', parameters('prefix'), variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('lawName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('environmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName')), '2023-09-01').primarySharedKey]"
          }
        },
        "vnetConfiguration": {
          "infrastructureSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'aca-infrastructure')]",
          "internal": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('lawName'))]"
      ]
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-11-01-preview",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "adminUserEnabled": true,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.Compute/virtualMachines', format('{0}-{1}-sdk-vm', parameters('prefix'), variables('suffix'))), 'Key Vault Secrets User')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Compute/virtualMachines', format('{0}-{1}-sdk-vm', parameters('prefix'), variables('suffix'))), '2024-07-01', 'full').identity.principalId]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', format('{0}-{1}-sdk-vm', parameters('prefix'), variables('suffix')))]"
      ]
    }
  ],
  "outputs": {
    "registryName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "acaEnvironmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "vmName": {
      "type": "string",
      "value": "[format('{0}-{1}-sdk-vm', parameters('prefix'), variables('suffix'))]"
    },
    "bastionName": {
      "type": "string",
      "value": "[format('{0}-{1}-bastion', parameters('prefix'), variables('suffix'))]"
    }
  }
}